{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(lldb) Launch cmake",
            "type": "lldb",
            "request": "launch",
            // Resolved by CMake Tools:
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${command:cmake.launchTargetDirectory}",
        },
        {
            "name": "(lldb) part extract",
            "type": "lldb",
            "request": "launch",
            // Resolved by CMake Tools:
            "program": "${command:cmake.launchTargetPath}",
            "args": ["../../../configs/test.yaml"],
            "cwd": "${command:cmake.launchTargetDirectory}",
        },
        {
            "name": "(lldb) xvfb part extract",
            "type": "lldb",
            "request": "launch",
            // "runtimeExecutable": "xvfb-run",
            // Resolved by CMake Tools:
            "program": "${command:cmake.launchTargetPath}",
            "args": ["../../../configs/test.yaml"],
            "cwd": "${command:cmake.launchTargetDirectory}",
            "env": {
                "DISPLAY": ":99"
            }
        }
